# Copy to deploy/.env and fill in real values before running docker compose. Never commit the
# real .env file - deploy/.gitignore already excludes it.

POSTGRES_DB=runner
POSTGRES_USER=runner
POSTGRES_PASSWORD=changeme

# The real domain this deployment is reachable at, e.g. "example.com" - Caddy then automatically
# obtains and renews a real TLS certificate for it via ACME/Let's Encrypt. Leave commented out (the
# default) to keep serving plain HTTP on :80, e.g. for a spike/local run with no domain purchased
# yet - uncommenting this with an empty value would NOT fall back to that default (see
# docker-compose.yml's own comment on why this must stay genuinely undefined, not just empty).
# SITE_ADDRESS=example.com

# Only read when docker-compose.debug.yml is also passed - loopback-only direct access to
# runner-service (bypassing Caddy) for measurement/debugging. See that file's own header comment.
RUNNER_SERVICE_DEBUG_PORT=8082
