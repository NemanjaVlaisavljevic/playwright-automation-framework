# Copy to deploy/.env and fill in real values before running docker compose. Never commit the
# real .env file - deploy/.gitignore already excludes it.

POSTGRES_DB=runner
POSTGRES_USER=runner
POSTGRES_PASSWORD=changeme

# D3.2 - admin authentication (GitHub OAuth2 Login). Register a GitHub OAuth App at
# https://github.com/settings/developers with Authorization callback URL exactly
# https://<your-domain>/api/v1/auth/oauth2/callback/github
RUNNER_SECURITY_GITHUB_CLIENT_ID=changeme
RUNNER_SECURITY_GITHUB_CLIENT_SECRET=changeme

# The numeric (immutable) GitHub account ID that gets admin access - NOT the username, which can
# change. Find it via: curl https://api.github.com/users/<your-github-username> (the "id" field).
# More than one ID may be supplied, comma-separated.
RUNNER_SECURITY_ADMIN_GITHUB_ID=changeme

# The real domain this deployment is reachable at, e.g. "example.com" - Caddy then automatically
# obtains and renews a real TLS certificate for it via ACME/Let's Encrypt. Leave commented out (the
# default) to keep serving plain HTTP on :80, e.g. for a spike/local run with no domain purchased
# yet - uncommenting this with an empty value would NOT fall back to that default (see
# docker-compose.yml's own comment on why this must stay genuinely undefined, not just empty).
# SITE_ADDRESS=example.com

# Only read when docker-compose.debug.yml is also passed - loopback-only direct access to
# runner-service (bypassing Caddy) for measurement/debugging. See that file's own header comment.
RUNNER_SERVICE_DEBUG_PORT=8082

# Remaps the HOST side of web's published ports (container side always stays 80/443 - see
# docker-compose.yml's own comment). Leave commented out in any real deployment, where 80/443 is
# exactly what's wanted. Only set these for a local acceptance run (D2.6-style) on a dev machine
# that already has something else bound to host 80/443 - e.g.:
# WEB_HTTP_BIND=18080
# WEB_HTTPS_BIND=18443

# D4.3.3 - becomes the ECS service.version field on every structured log line in the real
# deployment. Baked into the image at build time (a runtime environment override cannot change
# it) - a future CI/CD pipeline can pass a real value, e.g. a git tag/SHA. Defaults to "unknown"
# if left commented out.
# APP_VERSION=1.0.0

# Leave commented out (defaults to true) in any real deployment - a Secure session cookie is
# required there, and RUNNER_DEPLOYMENTPROFILE=PORTFOLIO refuses to start without one regardless
# of this value. Only set SESSION_COOKIE_SECURE=false for a local acceptance run reached over
# plain HTTP with no SITE_ADDRESS/TLS configured (browsers never send a Secure cookie to a non-
# HTTPS origin, so login would otherwise silently fail to persist a session) - and only alongside
# a non-PORTFOLIO RUNNER_DEPLOYMENTPROFILE override in docker-compose.yml for that same run.
# SESSION_COOKIE_SECURE=false

# D4.5 - backup/restore (deploy/backup/, deploy/docker-compose.backup.yml). Only read when that
# overlay file is explicitly included (`docker compose -f docker-compose.yml -f
# docker-compose.backup.yml ... run --rm backup`) - deliberately a SEPARATE overlay, not a
# profile-gated service in the base docker-compose.yml, precisely so a plain `docker compose -f
# docker-compose.yml up` never even evaluates these `${VAR:?...}` vars, let alone fails on them being
# unset (Compose interpolates every var in a file's own service definitions while building its
# config model, regardless of which profiles are active - see docker-compose.backup.yml's own header
# comment for the real failure this caused when it was first tried as a profile).

# The PUBLIC age recipient (age1...) backup.sh encrypts every dump to. NOT a secret - generate the
# real keypair once, offline, with `age-keygen`, and put ONLY the printed "Public key: age1..." line
# here. The matching PRIVATE identity file must never reside permanently on this host at all - keep
# it offline/in a password manager, and supply it only at actual restore time, mounted read-only for
# just that one invocation (see docker-compose.backup.yml's own header comment for the exact restore
# invocation, and docs/DEPLOYMENT_ARCHITECTURE.md section 7 for the full worked example).
BACKUP_AGE_RECIPIENT=changeme

# rclone remote name/bucket/prefix backup.sh uploads the encrypted dump to - an S3-compatible
# provider (e.g. Backblaze B2) is the reference target; BACKUP_REMOTE must match a remote name
# actually defined in the rclone config file BACKUP_RCLONE_CONFIG_FILE below points at (never this
# repo - real credentials never get near version control).
BACKUP_REMOTE=changeme
BACKUP_BUCKET=changeme
# BACKUP_PREFIX=runner-backups

# Absolute HOST path to a real rclone config file (holding BACKUP_REMOTE's own real credentials -
# an rclone `[b2]`-style remote block) - bind-mounted read-only into the `backup` service at
# /secrets/rclone.conf. Never commit this file; keep it alongside deploy/.env, outside the repo, or
# in whatever secret store the real host uses.
BACKUP_RCLONE_CONFIG_FILE=changeme

# A second, independent bound on remote backup retention, enforced by backup.sh itself
# (`rclone delete --min-age`) after every successful upload - the *primary* retention mechanism is
# the bucket's own lifecycle policy, configured on the bucket itself (see
# docs/DEPLOYMENT_ARCHITECTURE.md section 7), not this var. Leave commented out to rely on the
# lifecycle policy alone.
# BACKUP_RETENTION_DAYS=30

# backup.sh's own fail-closed local disk-budget guard (a flat floor alone can't tell whether
# there's room for the dump actually about to be attempted). Required free space before
# starting a new dump = BACKUP_MIN_FREE_BYTES (general headroom) + the source database's own real,
# live-measured size (`pg_database_size`) + BACKUP_DUMP_RESERVE_BYTES (an extra flat safety margin).
# Both default to 104857600 (100 MiB) if left commented out - raise BACKUP_DUMP_RESERVE_BYTES if the
# database is large/growing fast enough that 100 MiB of headroom over its own measured size feels
# thin.
# BACKUP_MIN_FREE_BYTES=104857600
# BACKUP_DUMP_RESERVE_BYTES=104857600
