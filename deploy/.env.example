# Copy to deploy/.env and fill in real values before running docker compose. Never commit the
# real .env file - deploy/.gitignore already excludes it.

POSTGRES_DB=runner
POSTGRES_USER=runner
POSTGRES_PASSWORD=changeme

# The two below are only read when docker-compose.debug.yml is also passed - the base compose file
# publishes no host ports at all. See deploy/docker-compose.debug.yml's own header comment.

# Host port the dashboard/API are reachable on (Caddy), via docker-compose.debug.yml. 8081 by
# default so it never collides with this repo's own dev-mode ports (5173 dashboard, 8080 backend)
# on the same machine.
WEB_PORT=8081

# Loopback-only direct access to runner-service (bypassing Caddy) for measurement/debugging.
RUNNER_SERVICE_DEBUG_PORT=8082
