# D4.4 performance-baseline env file - safe to commit (unlike deploy/.env, which is gitignored):
# every value below is a fake/local-only placeholder, and POSTGRES_DB is deliberately different
# from the real deployment's own "runner" database (see docker-compose.performance.yml's own
# header comment for why). Never use this file, or deploy/.env, for the other's purpose.
#
#   docker compose -p runner-performance -f deploy/docker-compose.yml \
#     -f deploy/docker-compose.performance.yml --env-file deploy/performance.env up --build

POSTGRES_DB=runner_performance
POSTGRES_USER=runner
POSTGRES_PASSWORD=performance-local-only-password

# Fake GitHub OAuth credentials - D4.4.1a-c never authenticate at all (read-only/anonymous
# scenarios); D4.4.1d's create-run scenario redirects the real OAuth binding to a WireMock stub
# (see deploy/docker-compose.performance.yml's own `wiremock` service) instead of ever using these
# for a real GitHub round trip. RUNNER_SECURITY_ADMIN_GITHUB_ID must match the numeric "id" field
# performance/wiremock/mappings/user-info.json stubs - never a real GitHub account.
RUNNER_SECURITY_GITHUB_CLIENT_ID=fake-id-for-performance-baseline
RUNNER_SECURITY_GITHUB_CLIENT_SECRET=fake-secret-for-performance-baseline
RUNNER_SECURITY_ADMIN_GITHUB_ID=999001

# k6 never reaches `web` through this host-published port at all (it hits http://web directly on
# the shared `edge` Docker network) - this remap only avoids colliding with whatever a dev machine
# already has bound to host port 80/443, mirroring deploy/.env.example's own WEB_HTTP_BIND escape
# hatch.
WEB_HTTP_BIND=18080
WEB_HTTPS_BIND=18443
