# {$SITE_ADDRESS::80} defaults to :80 (plain HTTP, no domain) until deploy/.env sets a real
# SITE_ADDRESS (see deploy/.env.example). Once a domain exists, docker-compose.yml passes
# SITE_ADDRESS through, publishes 80/443 (and 443/udp for HTTP/3) on `web`, and gives Caddy
# persistent named volumes for its /data (ACME account + certificates) and /config - without those,
# Caddy would re-request a fresh certificate on every container recreate and hit Let's Encrypt's
# rate limits. Not yet verified against a real domain - see docs/DEPLOYMENT_ARCHITECTURE.md.
{$SITE_ADDRESS::80} {
	encode gzip

	# CSP/Permissions-Policy live here, not in Spring Security: this header block applies to every
	# response Caddy serves, including the SPA's own index.html/JS/CSS (served by `file_server`
	# below) - a Spring-Security-only CSP would never reach the page that needs it most. Spring
	# Security deliberately never sets a CSP of its own.
	#
	# No inline scripts/styles, no `data:` URIs in the built dashboard bundle - so neither is added
	# here; add `data:` to img-src only if a future bundle change needs it. The one legitimate
	# cross-origin resource today is the logged-in admin's GitHub avatar image
	# (https://avatars.githubusercontent.com). `connect-src 'self'` also covers the SSE
	# `EventSource` connection (always same-origin). Caddy-only, like the rest of this block - no
	# CSP/Permissions-Policy is set for local `bootRun`/`dashboardE2eTest` (no Caddy in front
	# there), consistent with the Secure cookie and HSTS also being prod-only.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://avatars.githubusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Caddy normally runs directives in its own fixed internal order, not the order written below -
	# `try_files`/`file_server` would otherwise rewrite an unmatched path (including a real API
	# path like /api/v1/capabilities) to /index.html before reverse_proxy ever saw it, silently
	# serving the SPA shell instead of proxying it. Wrapping everything in one `route` block forces
	# top-to-bottom evaluation, so the reverse_proxy matchers below always get first refusal.
	route {
		# Only the three health paths are exposed publicly - not the full actuator surface, and not
		# /v3/api-docs (only needed by the dashboard's own build tooling against a running instance
		# directly, not through the public edge).
		reverse_proxy /actuator/health runner-service:8080
		# The Kubernetes-style liveness/readiness probe groups.
		reverse_proxy /actuator/health/liveness runner-service:8080
		reverse_proxy /actuator/health/readiness runner-service:8080

		# Fail closed on every other /actuator/* path. Without this, an unmatched /actuator/*
		# request would fall through to the SPA's try_files fallback below and silently return
		# React's index.html with a 200. Placed after the allowed proxies above and before the SPA
		# fallback below.
		@actuatorOther path /actuator/*
		respond @actuatorOther 404

		# SSE-safe by default - Caddy's reverse_proxy streams a chunked/event-stream response as it
		# arrives rather than buffering the whole thing, so RunEventStreamController's long-lived
		# connections work with no special flush_interval override needed.
		reverse_proxy /api/* runner-service:8080

		# React Router's client-side routing needs every other path to still resolve to
		# index.html - the SPA reads the real URL itself once loaded, Caddy just has to stop
		# returning 404 for it.
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
