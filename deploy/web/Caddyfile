# {$SITE_ADDRESS::80} defaults to :80 (plain HTTP, no domain) - the D0 spike/local Compose run,
# and still today's default in production until deploy/.env sets a real SITE_ADDRESS (see
# deploy/.env.example). D1 wired the rest of what real TLS needs once a domain exists:
# docker-compose.yml passes SITE_ADDRESS through, publishes 80/443 (and 443/udp for HTTP/3) on
# `web`, and gives Caddy persistent named volumes for its own /data (ACME account + certificates)
# and /config - without those, Caddy would re-request a fresh certificate on every container
# recreate and hit Let's Encrypt's rate limits. Not yet verified against a real domain (no domain
# purchased yet - D5's job) - see docs/DEPLOYMENT_ARCHITECTURE.md.
{$SITE_ADDRESS::80} {
	encode gzip

	# D3.3 - CSP/Permissions-Policy live here, not in Spring Security: this header block applies to
	# every response Caddy serves, including the SPA's own index.html/JS/CSS (served directly by
	# `file_server` below - runner-service is never in that response path at all, only proxied for
	# /api/*/actuator/health) - a Spring-Security-only CSP would never reach the page that needs it
	# most. Spring Security also deliberately never sets a CSP of its own; the app must define its
	# own concrete policy.
	#
	# CSP verified against the real production dashboard bundle (`npm run build` + reading the
	# built index.html/CSS): no inline scripts/styles, no `data:` URIs anywhere - so neither is
	# added here; add `data:` to img-src only if a future bundle change actually needs it, not
	# preemptively. The one legitimate cross-origin resource today is the logged-in admin's own
	# GitHub avatar image (`AuthControls.tsx`'s `<img src={avatarUrl}>`,
	# https://avatars.githubusercontent.com). `connect-src 'self'` also covers the SSE
	# `EventSource` connection (`/api/v1/runs/*/events` is always same-origin, never a cross-origin
	# URL). Deliberately Caddy-only, like the rest of this block - no CSP/Permissions-Policy is set
	# for local `bootRun`/`dashboardE2eTest` (no Caddy in front there), consistent with this
	# project's existing prod-only security-posture split (the Secure cookie and HSTS are both
	# prod-only for the identical reason).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://avatars.githubusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Caddy normally runs directives in its own fixed internal order, not the order written below -
	# `try_files`/`file_server` would otherwise rewrite an unmatched path (including a real API
	# path like /api/v1/capabilities) to /index.html *before* reverse_proxy ever saw the original
	# path, silently serving the SPA shell instead of proxying it (a real bug caught during the D0
	# spike by actually curling /api/v1/capabilities through Caddy, not assumed from the config
	# alone). Wrapping everything in one `route` block forces genuine top-to-bottom evaluation, so
	# the two reverse_proxy matchers below always get first refusal.
	route {
		# Only a bare health check is exposed publicly - not the full actuator surface (info is
		# enabled server-side too, per application.yml, but deliberately not proxied here) and not
		# /v3/api-docs (the OpenAPI document only ever needs to be reachable from the dashboard's
		# own build tooling, against a real running instance directly, not through the public edge
		# - see runner-dashboard/README.md's api:check:contract script).
		reverse_proxy /actuator/health runner-service:8080

		# SSE-safe by default - Caddy's reverse_proxy streams a chunked/event-stream response as it
		# arrives rather than buffering the whole thing, so RunEventStreamController's long-lived
		# connections work with no special flush_interval override needed.
		reverse_proxy /api/* runner-service:8080

		# React Router's client-side routing needs every other path to still resolve to
		# index.html - the SPA reads the real URL itself once loaded, Caddy just has to stop
		# returning 404 for it.
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
