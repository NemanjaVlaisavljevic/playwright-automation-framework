{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/login/oauth/authorize.*"
  },
  "response": {
    "status": 302,
    "headers": {
      "Location": "{{request.query.redirect_uri}}?code=perf-fake-authorization-code&state={{request.query.state}}"
    },
    "transformers": ["response-template"]
  }
}
