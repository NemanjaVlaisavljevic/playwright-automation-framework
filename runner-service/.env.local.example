# Local GitHub OAuth credentials for `./gradlew.bat :runner-service:bootRun` (Faza D3.2 - admin
# authentication). Copy this file to `.env.local` (gitignored, never commit it) and fill in real
# values. With no `.env.local` present, bootRun behaves exactly as it does today (no GitHub
# credentials configured -> the permissive security chain stays active, everything anonymous).
#
# Register a GitHub OAuth App at https://github.com/settings/developers with:
#   Application name:            Runner Dashboard Local
#   Homepage URL:                http://127.0.0.1:5173
#   Authorization callback URL:  http://127.0.0.1:5173/api/v1/auth/oauth2/callback/github
# (the callback must go through the Vite dev server's origin on port 5173, not the raw backend
# on :8080 - see the D3.2 plan for why).
RUNNER_SECURITY_GITHUB_CLIENT_ID=changeme
RUNNER_SECURITY_GITHUB_CLIENT_SECRET=changeme

# The numeric (immutable) GitHub account ID that gets admin access - NOT the username, which can
# change. Find it via: curl https://api.github.com/users/<your-github-username> (the "id" field).
# More than one ID may be supplied, comma-separated.
RUNNER_SECURITY_ADMIN_GITHUB_ID=changeme
